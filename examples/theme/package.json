{
  "name": "@untheme/example-theme",
  "private": true,
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./config": {
      "types": "./.dist/config.d.mts",
      "import": "./.dist/config.mjs"
    },
    "./manifest": {
      "types": "./.dist/manifest.d.mts",
      "import": "./.dist/manifest.mjs"
    },
    "./layers": {
      "types": "./.dist/layers.d.mts",
      "import": "./.dist/layers.mjs"
    },
    "./layers/*": "./.dist/layers/*",
    "./preset.json": "./.dist/preset.json",
    "./resolver.json": "./.dist/resolver.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "untheme build",
    "stub": "untheme build",
    "generate": "node scripts/generate.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@untheme/aurora": "workspace:*",
    "untheme": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@untheme/kit": "workspace:*",
    "@untheme/testing": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
