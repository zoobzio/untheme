{
  "name": "Upstream",
  "version": "2025.10",
  "description": "The document that the compose fixtures reference.",
  "sets": {
    "core": {
      "description": "The base tokens.",
      "sources": [
        {
          "$ref": "../base.json"
        }
      ]
    }
  },
  "modifiers": {
    "color": {
      "description": "The scheme.",
      "$extensions": {
        "io.zoobz.untheme": {
          "name": "Color scheme"
        }
      },
      "contexts": {
        "light": [{}],
        "dark": [
          {
            "$ref": "../dim.json"
          },
          {
            "color": {
              "$type": "color",
              "surface": {
                "$value": {
                  "colorSpace": "srgb",
                  "components": [
                    0.06666666666666667, 0.06666666666666667,
                    0.06666666666666667
                  ],
                  "alpha": 1,
                  "hex": "#111111"
                }
              }
            }
          }
        ]
      },
      "default": "light"
    },
    "density": {
      "contexts": {
        "default": [{}],
        "compact": [
          {
            "size": {
              "$type": "dimension",
              "md": {
                "$value": {
                  "value": 6,
                  "unit": "px"
                }
              }
            }
          }
        ]
      },
      "default": "default"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/core"
    },
    {
      "$ref": "#/modifiers/color"
    },
    {
      "$ref": "#/modifiers/density"
    }
  ]
}
