    "color": {
      "description": "The scheme: light or dark surfaces, with every role and channel rebound to match.",
      "$extensions": {
        "io.zoobz.untheme": {
          "name": "Color scheme"
        }
      },
      "contexts": {
        "light": [
          {
            "$ref": "./modifiers/color/light.json"
          }
        ],
        "dark": [
          {
            "$ref": "./modifiers/color/dark.json"
          }
        ]
      },
      "default": "light"
    },
    "vibrancy": {
      "description": "How saturated the accents are: each accent role steps to its muted or vivid chroma column.",
      "$extensions": {
        "io.zoobz.untheme": {
          "name": "Vibrancy"
        }
