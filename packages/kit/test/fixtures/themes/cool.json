{
  "$description": "A cooler primary over the fixture.",
  "$extensions": { "io.zoobz.untheme": { "name": "Cool" } },
  "color": {
    "$type": "color",
    "primary": {
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1, 0.4, 0.9],
          "hex": "#1a66e6"
        }
      },
      "default": { "$value": "{color.primary.50}" }
    }
  },
  "size": {
    "$type": "dimension",
    "md": { "$value": "{size.sm}" }
  }
}
